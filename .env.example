# Copy to .env and fill in. .env is gitignored.
# The nightly jobs read the same names from the GitHub environment
# "automated-tte-enrichment" (secrets for keys, variables for the rest).

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# The secret key (sb_secret_...), Project Settings -> API Keys. Full access to
# the database; used by the jobs and the export commands, never put in a page.
SUPABASE_KEY=

# The anon (public) key. Only used to build the online desk's page
# (python -m src.export --site); what it may read is set by sql/11.
SUPABASE_ANON_KEY=

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which models each job uses, and how it is batched and paced, is set in
# config/pipeline.toml, not here.
